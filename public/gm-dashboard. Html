<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>GuestHub - GM OS 14.0 ULTIMATE</title>
<script src="https://cdn.tailwindcss.com"></script>
<script src="/config.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
<style>*{font-family:Inter,sans-serif}.glass{backdrop-filter:blur(16px);background:rgba(255,255,255,.9)}@keyframes pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.05)}}.ding{animation:pulse.4s ease}</style>
</head>
<body class="bg-[#f6f7fb] text-slate-900">
<header class="sticky top-0 z-50 glass border-b"><div class="max-w-7xl mx-auto px-4 py-3 flex justify-between"><div class="flex gap-3 items-center"><div class="w-10 h-10 bg-black text-white grid place-items-center font-bold rounded-xl">G</div><div><h1 class="font-extrabold">GM OS 14.0 ULTIMATE</h1><p id="hotelNameLabel" class="text-xs text-slate-500">BAOBAB • Professional</p></div></div><div class="flex gap-2 items-center"><span id="demoBadge" class="hidden px-3 py-1 bg-amber-400 text-xs font-bold rounded-full">DEMO MODE</span><span id="clock" class="text-xs"></span><button id="soundBtn" class="px-3 py-1 bg-black text-white rounded-lg text-xs">🔔 Sound ON</button><button id="logoutBtn" class="px-3 py-1 bg-slate-100 rounded-lg text-xs">Logout</button></div></div></header>
<main class="max-w-7xl mx-auto px-4 py-6 grid grid-cols-12 gap-6">
<section class="col-span-12 lg:col-span-8 space-y-6">
<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
<div class="bg-white p-4 rounded-2xl border"><p class="text-xs text-slate-500">Today Revenue</p><h3 class="text-xl font-extrabold">KES <span id="todayRev">0</span></h3></div>
<div class="bg-white p-4 rounded-2xl border"><p class="text-xs text-slate-500">Today Orders</p><h3 id="todayOrders" class="text-xl font-extrabold">0</h3></div>
<div class="bg-white p-4 rounded-2xl border"><p class="text-xs text-slate-500">Active Vendors</p><h3 id="activeVendors" class="text-xl font-extrabold">12</h3></div>
<div class="bg-black p-4 rounded-2xl text-white"><p class="text-xs text-zinc-400">My 15% Commission</p><h3 class="text-xl font-extrabold">KES <span id="myCommission">0</span></h3></div>
</div>
<div class="bg-white rounded-2xl border overflow-hidden"><div class="p-4 flex justify-between border-b"><h2 class="font-bold">Live Orders • <span id="ordersCount" class="text-sm text-slate-500">0 orders</span></h2><div class="flex gap-2"><button id="filterAll" class="px-3 py-1 bg-black text-white rounded-full text-xs">All</button><button data-filter="new" class="filterBtn px-3 py-1 bg-slate-100 rounded-full text-xs">New</button><button data-filter="accepted" class="filterBtn px-3 py-1 bg-slate-100 rounded-full text-xs">Accepted</button></div></div><div id="ordersList" class="divide-y max-h-[600px] overflow-auto"><div class="p-8 text-center text-slate-400 text-sm">Loading...</div></div></div>
</section>
<section class="col-span-12 lg:col-span-4 space-y-6">
<div class="bg-white p-5 rounded-2xl border"><h3 class="font-bold">Hotel Profile</h3><div class="mt-3 text-sm space-y-2"><div class="flex justify-between"><span class="text-slate-500">Hotel ID</span><span id="hotelId" class="font-semibold">BAOBAB</span></div><div class="flex justify-between"><span class="text-slate-500">Plan</span><span id="hotelPlan">Upendo</span></div></div><a id="guestLink" href="#" class="mt-4 block text-center py-2 bg-amber-400 rounded-xl font-bold text-sm">Open Guest Page →</a></div>
<div class="bg-white p-5 rounded-2xl border"><div class="flex justify-between"><h3 class="font-bold">Services</h3><button id="addServiceBtn" class="text-xs px-2 py-1 bg-black text-white rounded">+ Add</button></div><div id="servicesList" class="mt-4 space-y-2 max-h-[300px] overflow-auto text-xs text-slate-400">Loading...</div></div>
<div class="bg-white p-5 rounded-2xl border"><h3 class="font-bold text-sm">WhatsApp Routing</h3><div id="waGrid" class="mt-3 grid gap-2"></div><button id="saveWA" class="mt-3 w-full py-2 bg-black text-white rounded-xl text-sm">Save</button></div>
<div class="bg-gradient-to-br from-amber-400 to-orange-400 p-5 rounded-2xl"><h3 class="font-extrabold">GMV & My Cut</h3><div class="mt-3 grid grid-cols-2 gap-3"><div class="bg-black text-white p-3 rounded-xl"><p class="text-[10px] opacity-60">GMV Total</p><p class="font-bold text-sm">KES <span id="gmvTotal">0</span></p></div><div class="bg-white p-3 rounded-xl"><p class="text-[10px]">Vendor 85%</p><p class="font-bold text-sm">KES <span id="vendorPayout">0</span></p></div></div></div>
</section>
</main>
<div id="serviceModal" class="hidden fixed inset-0 bg-black/40 grid place-items-center p-4"><div class="bg-white p-6 rounded-2xl w-full max-w-md"><h3 class="font-bold">Add Service</h3><div class="mt-4 space-y-3"><input id="sTitle" placeholder="Title" class="w-full px-3 py-2 border rounded-xl text-sm"/><input id="sPrice" type="number" placeholder="Price" class="w-full px-3 py-2 border rounded-xl text-sm"/><input id="sCategory" placeholder="Category" class="w-full px-3 py-2 border rounded-xl text-sm"/><textarea id="sDesc" placeholder="Desc" class="w-full px-3 py-2 border rounded-xl text-sm"></textarea></div><div class="mt-5 flex gap-2"><button id="closeModal" class="flex-1 py-2 bg-slate-100 rounded-xl text-sm">Cancel</button><button id="saveService" class="flex-1 py-2 bg-black text-white rounded-xl text-sm">Save</button></div></div></div>
<script>
const params=new URLSearchParams(location.search);const IS_DEMO=params.has('demo');const HOTEL_ID=(params.get('hotel')||'BAOBAB').toUpperCase();let SOUND_ON=true,lastOrderIds=new Set(),allOrders=[],allServices=[],currentFilter='all';
function $(id){return document.getElementById(id)}function clean(v){return String(v||'').trim()}
function playDing(){if(!SOUND_ON)return;try{const ctx=new (window.AudioContext||window.webkitAudioContext)();const o=ctx.createOscillator();const g=ctx.createGain();o.frequency.value=880;o.connect(g);g.connect(ctx.destination);g.gain.setValueAtTime(0,ctx.currentTime);g.gain.linearRampToValueAtTime(1,ctx.currentTime+0.01);g.gain.exponentialRampToValueAtTime(0.001,ctx.currentTime+0.6);o.start();o.stop(ctx.currentTime+0.6);document.body.classList.add('ding');setTimeout(()=>document.body.classList.remove('ding'),400)}catch(e){}}
function getToken(){return IS_DEMO?'demo-token':localStorage.getItem('gh_token')||''}
setInterval(()=>{const d=new Date();$('clock').textContent=d.toLocaleTimeString()},1000);
if(IS_DEMO){$('demoBadge').classList.remove('hidden');$('hotelNameLabel').textContent=HOTEL_ID+' • DEMO MODE'}
$('guestLink').href='/guest.html?hotel='+HOTEL_ID;$('hotelId').textContent=HOTEL_ID;
$('soundBtn').onclick=()=>{SOUND_ON=!SOUND_ON;$('soundBtn').textContent=SOUND_ON?'🔔 Sound ON':'🔕 Sound OFF';if(SOUND_ON)playDing()};
$('logoutBtn').onclick=()=>{if(IS_DEMO){location.href='/';return}localStorage.removeItem('gh_token');location.href='/hotel-login.html'};
function demoOrders(){return[{id:'d1',room:'101',guest_name:'John',service_title:'Taxi to Airport',amount:2500,status:'new',created_at:new Date().toISOString()},{id:'d2',room:'202',guest_name:'Aisha',service_title:'Laundry',amount:900,status:'accepted',created_at:new Date(Date.now()-900000).toISOString()},{id:'d3',room:'105',guest_name:'Mike',service_title:'Spa Massage',amount:3500,status:'new',created_at:new Date(Date.now()-1800000).toISOString()},{id:'d4',room:'303',guest_name:'Sarah',service_title:'Dinner',amount:1800,status:'completed',created_at:new Date(Date.now()-7200000).toISOString()}]}
function demoServices(){return[{id:'s1',title:'Taxi to SGR',price:2000,category:'taxi'},{id:'s2',title:'Laundry',price:300,category:'laundry'},{id:'s3',title:'Spa',price:3000,category:'spa'},{id:'s4',title:'Tour to Fort Jesus',price:5000,category:'tours'}]}
async function fetchWithAuth(url,opts={}){const h=opts.headers||{};const t=getToken();if(t)h['Authorization']='Bearer '+t;opts.headers=h;const r=await fetch(url,opts);if(r.status===401&&!IS_DEMO)location.href='/hotel-login.html';return r}
async function loadDashboard(){if(IS_DEMO){const o=demoOrders();const s=demoServices();renderOrders(o);renderServices(s);updateKPIs(o);return}try{const r=await fetchWithAuth('/api/gm/dashboard');const j=await r.json();if(!j.ok){$('ordersList').innerHTML='<div class="p-6 text-red-500 text-sm">'+(j.error||'Failed')+'</div>';return}renderOrders(j.orders||[]);renderServices(j.services||j.items||[]);updateKPIs(j.orders||[],j.revenue)}catch(e){console.error(e)}}
function updateKPIs(orders,revenue){const today=new Date().toISOString().slice(0,10);const todayOrders=orders.filter(o=>(o.created_at||'').startsWith(today));const todayRev=todayOrders.reduce((s,o)=>s+Number(o.amount||0),0);const totalRev=revenue!=null?revenue:orders.reduce((s,o)=>s+Number(o.amount||0),0);$('todayRev').textContent=todayRev.toLocaleString();$('todayOrders').textContent=todayOrders.length||orders.length;$('myCommission').textContent=Math.floor(totalRev*0.15).toLocaleString();$('ordersCount').textContent=orders.length+' orders';if($('gmvTotal'))$('gmvTotal').textContent=totalRev.toLocaleString();if($('vendorPayout'))$('vendorPayout').textContent=Math.floor(totalRev*0.85).toLocaleString()}
function renderOrders(orders){allOrders=orders;const filtered=currentFilter==='all'?orders:orders.filter(o=>clean(o.status)==currentFilter);if(!filtered.length){$('ordersList').innerHTML='<div class="p-8 text-center text-slate-400 text-sm">No '+currentFilter+' orders</div>';return}const newIds=filtered.map(o=>o.id).filter(id=>!lastOrderIds.has(id));if(newIds.length>0&&lastOrderIds.size>0)playDing();lastOrderIds=new Set(filtered.map(o=>o.id));$('ordersList').innerHTML=filtered.map(o=>{const st=clean(o.status||'new');const col=st==='new'?'bg-amber-100 text-amber-700':st==='accepted'?'bg-blue-100 text-blue-700':'bg-emerald-100 text-emerald-700';const time=o.created_at?new Date(o.created_at).toLocaleString():'';return `<div class="p-4 flex justify-between hover:bg-slate-50"><div><div class="flex gap-2 items-center"><span class="font-bold text-sm">${o.room||'-'} • ${o.guest_name||'Guest'}</span><span class="px-2 py-0.5 rounded-full text-[10px] ${col} uppercase">${st}</span></div><p class="text-sm font-semibold mt-1">${o.service_title||o.service}</p><p class="text-xs text-slate-500">KES ${Number(o.amount||0).toLocaleString()} • ${time}</p></div><div class="flex flex-col gap-1 ml-3">${st==='new'?`<button onclick="acceptOrder('${o.id}')" class="px-3 py-1 bg-black text-white rounded-lg text-xs">Accept</button>`:''}<button onclick="completeOrder('${o.id}')" class="px-3 py-1 bg-slate-100 rounded-lg text-xs">Complete</button></div></div>`}).join('')}
function renderServices(services){allServices=services;if(!services.length){$('servicesList').innerHTML='<div class="text-xs text-slate-400">No services - Add taxi, tours etc</div>';return}$('servicesList').innerHTML=services.map(s=>`<div class="flex justify-between p-2 border rounded-xl"><div><p class="text-sm font-semibold">${s.title}</p><p class="text-xs text-slate-500">KES ${Number(s.price||0).toLocaleString()} • ${s.category}</p></div><button onclick="deleteService('${s.id}')" class="text-xs px-2 py-1 bg-red-50 text-red-600 rounded">Del</button></div>`).join('')}
document.querySelectorAll('.filterBtn').forEach(b=>{b.onclick=()=>{document.querySelectorAll('.filterBtn').forEach(x=>x.className='filterBtn px-3 py-1 bg-slate-100 rounded-full text-xs');b.className='filterBtn px-3 py-1 bg-black text-white rounded-full text-xs';$('filterAll').className='px-3 py-1 bg-slate-100 rounded-full text-xs';currentFilter=b.dataset.filter;renderOrders(allOrders)}});
$('filterAll').onclick=()=>{currentFilter='all';document.querySelectorAll('.filterBtn').forEach(x=>x.className='filterBtn px-3 py-1 bg-slate-100 rounded-full text-xs');$('filterAll').className='px-3 py-1 bg-black text-white rounded-full text-xs';renderOrders(allOrders)};
async function acceptOrder(id){if(IS_DEMO){alert('DEMO: Order '+id+' accepted ✅');playDing();return}const r=await fetchWithAuth('/api/orders/'+id+'/status',{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({status:'accepted'})});const j=await r.json();if(j.ok)loadDashboard()}
async function completeOrder(id){if(IS_DEMO){alert('DEMO: Order '+id+' completed');return}const r=await fetchWithAuth('/api/orders/'+id+'/status',{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({status:'completed'})});const j=await r.json();if(j.ok)loadDashboard()}
function initWA(){const fields=[['whatsapp_kitchen','Kitchen'],['whatsapp_house','Housekeeping'],['whatsapp_laundry','Laundry'],['whatsapp_spa','Spa'],['whatsapp_taxi','Taxi'],['whatsapp_tours','Tours'],['whatsapp_front','Front']];$('waGrid').innerHTML=fields.map(([k,l])=>`<div class="flex gap-2 items-center"><label class="text-xs w-24 text-slate-600">${l}</label><input id="${k}" placeholder="2547..." class="flex-1 px-2 py-1.5 border rounded-lg text-xs"/></div>`).join('')}
initWA();
$('saveWA').onclick=async()=>{if(IS_DEMO){alert('DEMO: WhatsApp saved ✅');return}const payload={};document.querySelectorAll('#waGrid input').forEach(inp=>{if(inp.value)payload[inp.id]=inp.value});const r=await fetchWithAuth('/api/gm/whatsapp',{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});const j=await r.json();alert(j.ok?'Saved ✅':j.error)};
$('addServiceBtn').onclick=()=>$('serviceModal').classList.remove('hidden');$('closeModal').onclick=()=>$('serviceModal').classList.add('hidden');
$('saveService').onclick=async()=>{const title=clean($('sTitle').value);const price=Number($('sPrice').value);const cat=clean($('sCategory').value);if(!title||!price){alert('Title & price required');return}if(IS_DEMO){allServices.unshift({id:'s'+Date.now(),title,price,category:cat});renderServices(allServices);$('serviceModal').classList.add('hidden');return}const r=await fetchWithAuth('/api/admin/services',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({hotel_id:HOTEL_ID,title,price,category:cat,active:true})});const j=await r.json();if(j.ok){$('serviceModal').classList.add('hidden');loadDashboard()}else alert(j.error)};
async function deleteService(id){if(!confirm('Delete?'))return;if(IS_DEMO){allServices=allServices.filter(s=>s.id!==id);renderServices(allServices);return}const r=await fetchWithAuth('/api/admin/services/'+id,{method:'DELETE'});const j=await r.json();if(j.ok)loadDashboard()}
if(IS_DEMO){setInterval(()=>{const fake={id:'demo'+Date.now(),room:Math.floor(Math.random()*300+100).toString(),guest_name:['John','Aisha','Mike','Sarah','Brian'][Math.floor(Math.random()*5)],service_title:['Taxi to Airport','Laundry','Spa','Tours','Food'][Math.floor(Math.random()*5)],amount:[1200,2500,900,3500,1800][Math.floor(Math.random()*5)],status:'new',created_at:new Date().toISOString()};allOrders.unshift(fake);renderOrders(allOrders);updateKPIs(allOrders);playDing()},30000)}
loadDashboard();setInterval(()=>{if(!document.hidden)loadDashboard()},15000);
window.acceptOrder=acceptOrder;window.completeOrder=completeOrder;window.deleteService=deleteService;
</script>
</body>
</html>
